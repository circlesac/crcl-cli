{
  "version": 1,
  "cases": [
    {
      "name": "JWT with numeric expiration",
      "value": "eyJhbGciOiJub25lIn0.eyJzdWIiOiJ2YWxpZCIsImV4cCI6NDEwMjQ0NDgwMH0.signature",
      "expected": { "kind": "jwt", "expires_at_unix": 4102444800 }
    },
    {
      "name": "JWT without expiration",
      "value": "eyJhbGciOiJub25lIn0.eyJzdWIiOiJuby1leHAifQ.signature",
      "expected": { "kind": "jwt" }
    },
    {
      "name": "opaque API key",
      "value": "circles_opaque_key",
      "expected": { "kind": "api_key" }
    },
    {
      "name": "three opaque segments are not a JWT",
      "value": "not-json.still-not-json.signature",
      "expected": { "kind": "api_key" }
    },
    {
      "name": "JWT expiration must be numeric",
      "value": "eyJhbGciOiJub25lIn0.eyJzdWIiOiJiYWQtZXhwIiwiZXhwIjoibGF0ZXIifQ.signature",
      "error": "INVALID_CREDENTIAL"
    },
    {
      "name": "whitespace is invalid",
      "value": "secret value",
      "error": "INVALID_CREDENTIAL",
      "secret_safe": true
    }
  ]
}
