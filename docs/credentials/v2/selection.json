{
  "version": 2,
  "cases": [
    {
      "name": "current profile wins over legacy default",
      "config": "[__circles__]\ncurrent_profile = prod:yg@melten.ai\n",
      "profiles": {
        "prod:yg@melten.ai": { "api_key": "melten-key" },
        "default": { "api_key": "default-key" }
      },
      "expected": {
        "value": "melten-key",
        "kind": "api_key",
        "source": { "type": "profile", "profile": "prod:yg@melten.ai" }
      }
    },
    {
      "name": "explicit profile wins over current profile",
      "explicit_profile": "default",
      "config": "[__circles__]\ncurrent_profile = prod:yg@melten.ai\n",
      "profiles": {
        "prod:yg@melten.ai": { "api_key": "melten-key" },
        "default": { "api_key": "default-key" }
      },
      "expected": {
        "value": "default-key",
        "kind": "api_key",
        "source": { "type": "profile", "profile": "default" }
      }
    },
    {
      "name": "environment credential wins over current profile",
      "env": { "CIRCLES_AUTH_TOKEN": "environment-key" },
      "config": "[__circles__]\ncurrent_profile = prod:yg@melten.ai\n",
      "profiles": {
        "prod:yg@melten.ai": { "api_key": "melten-key" }
      },
      "expected": {
        "value": "environment-key",
        "kind": "api_key",
        "source": { "type": "environment" }
      }
    },
    {
      "name": "environment profile wins over current profile",
      "env": { "CIRCLES_PROFILE": "default" },
      "config": "[__circles__]\ncurrent_profile = prod:yg@melten.ai\n",
      "profiles": {
        "prod:yg@melten.ai": { "api_key": "melten-key" },
        "default": { "api_key": "default-key" }
      },
      "expected": {
        "value": "default-key",
        "kind": "api_key",
        "source": { "type": "profile", "profile": "default" }
      }
    },
    {
      "name": "missing current profile is terminal",
      "config": "[__circles__]\ncurrent_profile = missing@example.com\n",
      "profiles": {
        "default": { "api_key": "default-key" }
      },
      "error": "CREDENTIAL_NOT_FOUND"
    },
    {
      "name": "absent current profile falls back to legacy default",
      "profiles": {
        "default": { "api_key": "default-key" }
      },
      "expected": {
        "value": "default-key",
        "kind": "api_key",
        "source": { "type": "profile", "profile": "default" }
      }
    },
    {
      "name": "reserved metadata section cannot be selected",
      "explicit_profile": "__circles__",
      "config": "[__circles__]\ncurrent_profile = default\n",
      "profiles": {
        "default": { "api_key": "default-key" }
      },
      "error": "INVALID_CREDENTIAL"
    }
  ]
}
